# 肺结节AI模型评估系统 · 环境变量样例
#
# 用法：复制为 .env 后填入院内实际值，或在系统环境变量中直接配置。
# 全部凭据只从环境变量读取，代码中不设任何静默默认值；
# 缺失时 doctor 会指名报出缺哪个变量，绝不自动回落到本地替身。
#
# 本文件不含任何真实密钥，请勿把填好的 .env 提交入库（.gitignore 已排除 .env）。

# ---- 院内 RIS：检查清单读取（病例与图像引用的权威数据源）----
RIS_BASE_URL=https://ris.example-hospital.internal
RIS_API_TOKEN=

# ---- 厂商肺结节 AI 推理服务：逐例检出与测量 ----
INFERENCE_BASE_URL=https://nodule-ai.example-vendor.internal
INFERENCE_API_TOKEN=

# ---- 院内科研平台：人工确认后的评估登记写回 ----
RESEARCH_PLATFORM_BASE_URL=https://research.example-hospital.internal
RESEARCH_PLATFORM_TOKEN=
# 可选：写回提交体的大小上限（字节，默认 1048576 = 1 MiB）。
# 科研平台侧改了请求体上限就改这里；超限时产品会明确报错并提示分批，
# 绝不静默截断逐例明细。
RESEARCH_PLATFORM_MAX_PAYLOAD_BYTES=1048576

# ---- 模型网关（OpenAI-compatible 单一协议）----
OPENAI_BASE_URL=https://api.example-llm.internal/v1
OPENAI_API_KEY=
OPENAI_MODEL=nodule-goldstd-merge
MODEL_TIMEOUT=20
MODEL_MAX_RETRIES=2
MODEL_TEMPERATURE=0

# ---- 本地替身开关（默认关闭；仅用于自动化测试，禁止在院内正式路径开启）----
# IMAGING_EVAL_FIXTURE=1 才会把出站目标改走本地替身；缺了替身地址会指名报错，
# 绝不会悄悄回落到替身，也绝不会在缺替身地址时回落到真实端点。
IMAGING_EVAL_FIXTURE=0
# 统一替身地址（三个替身跑在同一台机器上时用这一个）。
IMAGING_EVAL_FIXTURE_BASE_URL=
# 分端点替身地址（可选；给了就优先于统一地址）。
IMAGING_EVAL_FIXTURE_RIS_BASE_URL=
IMAGING_EVAL_FIXTURE_INFERENCE_BASE_URL=
IMAGING_EVAL_FIXTURE_RESEARCH_BASE_URL=
IMAGING_EVAL_FIXTURE_MODEL_BASE_URL=
